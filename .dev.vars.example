# Copy to .dev.vars for local development (`npm run dev`).
# .dev.vars is git-ignored. Never commit real values.

# Required: site password, and a random signing secret (≥ 32 characters,
# e.g. `openssl rand -base64 32`). Without both, every page fails closed.
APP_PASSWORD=
SESSION_SECRET=

# AI features (screenshots, price estimate, seller message, known issues):
GEMINI_API_KEY=
# Optional model per task (defaults shown):
# GEMINI_MODEL_VISION=gemini-3.6-flash
# GEMINI_MODEL_TEXT=gemini-3.5-flash-lite

# To try Anthropic locally instead:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
